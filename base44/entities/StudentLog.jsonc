      "type": "string",
      "description": "Student onboarding document status"
    },
    "community_status": {
      "type": "string",
      "description": "Community Status"
    },
    "current_class_status": {
      "type": "string",
      "description": "Current Class Status"
    },
    "last_attended_class": {
      "type": "string",
      "format": "date",
      "description": "Last attended Class"
    },
    "exam_date": {
      "type": "string",
      "format": "date",
      "description": "Exam Date"
    },
    "exam_status": {
      "type": "string",
      "enum": [
        "Attended",
        "Not Attended",
        "Scheduled",
        "Passed",
        "Failed"
      ],
      "description": "Exam Status"
    },
    "exam_not_attended_reason": {
      "type": "string",
      "description": "If not attended, reason"
    },
    "exam_valuation_date": {
      "type": "string",
      "format": "date",
      "description": "Exam valuation Date"
    },
    "exam_evaluator": {
      "type": "string",
      "description": "Exam Evaluator"
    },
    "exam_marks": {
      "type": "number",
      "description": "Exam Marks"
    },
    "exam_result": {
      "type": "string",
      "enum": [
        "Pass",
        "Fail",
        "Pending"
      ],
      "description": "Exam Result"
    },
