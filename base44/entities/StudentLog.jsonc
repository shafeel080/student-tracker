{
  "name": "StudentLog",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "description": "Reference to Student entity"
    },
    "student_code": {
      "type": "string",
      "description": "Student Code"
    },
    "student_name": {
      "type": "string",
      "description": "Student Name"
    },
    "followup_priority": {
      "type": "string",
      "enum": [
        "High",
        "Medium",
        "Low"
      ],
      "description": "Followup Priority"
    },
    "active_in_classes": {
      "type": "boolean",
      "default": true,
      "description": "Active/Non Active in Classes"
    },
    "not_attending_reason": {
      "type": "string",
      "description": "If not attending - Reason"
    },
    "last_contact_date": {
      "type": "string",
      "format": "date",
      "description": "Last Contact date"
    },
    "last_contact_person": {
      "type": "string",
      "description": "Last contact person"
    },
    "contact_history": {
      "type": "string",
      "description": "Contact History - Detailed Explanation"
    },
    "preferred_contact_mode": {
      "type": "string",
      "enum": [
        "Phone",
        "Email",
        "WhatsApp",
        "In-Person",
        "Video Call"
      ],
      "description": "Preferred mode of Contact"
    },
    "email": {
      "type": "string",
      "description": "Email ID"
    },
    "phone_number": {
      "type": "string",
      "description": "Phone Number"
    },
    "home_country_contact": {
      "type": "string",
      "description": "Home Country Contact number"
    },
    "emergency_contact": {
      "type": "string",
      "description": "Emergency Contact Number & Person"
    },
    "nationality": {
      "type": "string",
      "description": "Nationality"
    },
    "gender": {
      "type": "string",
      "enum": [
        "Male",
        "Female",
        "Other"
      ],
      "description": "Gender"
    },
    "dob": {
      "type": "string",
      "format": "date",
      "description": "Date of Birth"
    },
    "occupation": {
      "type": "string",
      "description": "Occupation"
    },
    "permanent_address": {
      "type": "string",
      "description": "Permanent Address (Home Country)"
    },
    "residency_address": {
      "type": "string",
      "description": "Residency address"
    },
    "passport_number": {
      "type": "string",
      "description": "Passport number"
    },
    "emirates_id": {
      "type": "string",
      "description": "Emirates ID/Residence ID"
    },
    "photo_url": {
      "type": "string",
      "description": "Professional Photo URL"
    },
    "passport_copy_url": {
      "type": "string",
      "description": "Passport Copy URL"
    },
    "date_of_joining": {
      "type": "string",
      "format": "date",
      "description": "Date of Joining"
    },
    "month_of_joining": {
      "type": "string",
      "description": "Month of Joining"
    },
    "course_enrolled": {
      "type": "string",
      "description": "Course Enrolled"
    },
    "preferred_language": {
      "type": "string",
      "description": "Preferred Language"
    },
    "academic_counselors": {
      "type": "string",
      "description": "Academic Counselors"
    },
    "mode_of_study": {
      "type": "string",
      "enum": [
        "Online",
        "Offline",
        "Hybrid"
      ],
      "description": "Mode of study"
