      "type": "string",
      "format": "date",
      "description": "Last Attended live trade"
    },
    "trading_status": {
      "type": "string",
      "description": "Trading Status"
    },
    "current_broker": {
      "type": "string",
      "description": "Current Broker"
    },
    "assets_traded": {
      "type": "string",
      "description": "Assets he trades"
    },
    "current_profit_loss": {
      "type": "number",
      "description": "Current P/L"
    },
    "potential_to_deposit": {
      "type": "boolean",
      "default": false,
      "description": "Is he potential to deposit"
    },
    "easy_to_convince": {
      "type": "boolean",
      "default": false,
      "description": "Easy to convince"
    },
    "total_loss_from_trading": {
      "type": "number",
      "description": "Total Loss from Trading"
    },
    "rejoining_response": {
      "type": "string",
      "enum": [
        "Interested",
        "Not Interested",
        "Pending"
      ],
      "description": "Rejoining Response"
    },
    "rejoining_date": {
      "type": "string",
      "format": "date",
      "description": "Date of rejoining"
    },
    "rejoining_measures": {
      "type": "string",
      "description": "Measures taken for rejoining"
    },
    "rejoined_class": {
      "type": "string",
      "description": "Rejoined Class"
    },
    "rejoining_sales_person": {
      "type": "string",
      "description": "Sales person"
    },
    "rejoinees_feedback": {
      "type": "string",
      "description": "Rejoinees Feedback"
    },
    "mentor_assigned": {
      "type": "string",
      "description": "Mentor Assigned (last)"
    },
    "attended_senior_mentor_class": {
      "type": "boolean",
      "default": false,
      "description": "Did the student attended senior mentor class"
    },
    "discussion_with_senior_mentor": {
      "type": "boolean",
      "default": false,
      "description": "Did the client had the discussion session"
    },
    "practice_sessions_attended": {
      "type": "number",
      "default": 0,
      "description": "How many Practice Sessions Attended"
    },
    "seminars_attended_count": {
      "type": "number",
      "default": 0,
      "description": "Number of Seminars attended"
    },
    "online_seminars_list": {
      "type": "string",
      "description": "List of Online Seminars Attended"
    },
    "offline_seminars_list": {
      "type": "string",
      "description": "List of Offline Seminars Attended"
    },
    "seminars_not_attended_reason": {
      "type": "string",
      "description": "If not attended, reason"
    },
    "feedback": {
      "type": "string",
      "description": "Feedback"
    },
    "testimonial_done": {
      "type": "boolean",
      "default": false,
      "description": "Testimonial Done"
    },
    "google_review": {
      "type": "boolean",
      "default": false,
      "description": "Google review"
    },
    "subscribed_for_pipscraft": {
      "type": "boolean",
      "default": false,
      "description": "Subscribed for pips craft"
    },
    "pipscraft_subscription_date": {
      "type": "string",
      "format": "date",
      "description": "When subscribed for pipscraft"
    },
    "still_using_pipscraft": {
      "type": "boolean",
      "default": false,
      "description": "Is the client still using the service"
    },
    "pipscraft_satisfaction": {
      "type": "string",
      "enum": [
        "Satisfied",
        "Not Satisfied"
      ],
      "description": "Is the client satisfied with service"
    },
    "pipscraft_not_satisfied_reason": {
      "type": "string",
      "description": "If not satisfied, why"
    },
    "pipscraft_subscribed_agent": {
      "type": "string",
      "description": "Pipscraft subscribed agent"
    }
