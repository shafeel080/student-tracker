      "type": "string",
      "enum": [
        "Paid",
        "Pending",
        "Partial",
        "Overdue"
      ],
      "description": "Payment Status"
    },
    "payment_mode": {
      "type": "string",
      "description": "Payment Mode"
    },
    "payment_date": {
      "type": "string",
      "format": "date",
      "description": "Payment Date"
    },
    "payment_due": {
      "type": "number",
      "description": "Payment Due"
    },
    "discount": {
      "type": "number",
      "description": "Discount"
    },
