      "type": "string",
      "format": "date",
      "description": "Date of Upgrade"
    },
    "upgrade_month": {
      "type": "string",
      "description": "Month of Upgrade"
    },
    "convocation_status": {
      "type": "string",
      "description": "Convocation"
    },
    "certificate_status": {
      "type": "string",
      "description": "Certificate status (KHDA, Delta)"
    },
    "convocation_month": {
      "type": "string",
      "description": "Convocation month"
    },
    "invited_traders_dayout": {
      "type": "boolean",
      "default": false,
      "description": "Invited for Traders day out"
    },
    "traders_dayout_invite_reason": {
      "type": "string",
      "description": "Reason for invite"
    },
    "traders_dayout_outcome": {
      "type": "string",
      "description": "Outcome for Traders Dayout"
    },
    "trading_journal_management": {
      "type": "string",
      "description": "Trading Journal Management"
    },
    "trading_journal_link": {
      "type": "string",
      "description": "Journal Link"
    },
